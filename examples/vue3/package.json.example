{
  "name": "vue3-qa-blueprint",
  "version": "2.0.0",
  "description": "Plantilla base para Frontend Vue 3 corporativo (Linting, Stryker, Lighthouse, Playwright y Vitest)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\" \"tests/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue}\" \"tests/**/*.{js,ts}\"",
    "lint": "eslint . --ext .vue,.js,.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "audit:deps": "npm audit",
    "test:e2e": "playwright test",
    "test:perf": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^1.2.3",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.43.0",
    "@stryker-mutator/core": "^8.2.6",
    "@stryker-mutator/vitest-runner": "^8.2.6",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-sonarjs": "^0.24.0",
    "eslint-plugin-vue": "^9.21.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^9.4.2",
    "vue-tsc": "^1.8.27"
  }
}
