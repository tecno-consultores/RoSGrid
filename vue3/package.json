{
  "name": "rosgrid-frontend",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "Consola Web Centralizada Multi-Tenant para Flotas MikroTik RouterOS v7+ (Vue 3 + TS + Pinia)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\" \"e2e/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue}\" \"e2e/**/*.{js,ts}\"",
    "lint": "eslint . --ext .vue,.js,.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "audit:deps": "pnpm audit --prod",
    "test:e2e": "playwright test",
    "test:perf": "lhci autorun"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pinia": "^2.2.2",
    "qrcode": "^1.5.4",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.43.0",
    "@stryker-mutator/core": "^8.2.6",
    "@stryker-mutator/vitest-runner": "^8.2.6",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/coverage-v8": "^1.3.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-sonarjs": "^0.24.0",
    "eslint-plugin-vue": "^9.21.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "typescript": "~5.4.5",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "vue-eslint-parser": "^9.4.2",
    "vue-tsc": "^1.8.27"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright",
      "@playwright/test"
    ]
  }
}
