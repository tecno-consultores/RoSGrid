# ADVERTENCIA: Nunca hagas commit de un archivo .env real.
# ==============================================================================

# --- Entorno y Puertos de Despliegue ---
ROSGRID_ENV=production
ROSGRID_HTTP_PORT=8080
ROSGRID_INSTALL_DIR=/opt/rosgrid

# --- PostgreSQL 17 ---
POSTGRES_HOST=rosgrid_db
POSTGRES_PORT=5432
POSTGRES_DB=rosgrid
POSTGRES_USER=rosgrid_user
POSTGRES_PASSWORD=cambiar_en_entorno_local

# --- KeyDB / Redis 7 ---
REDIS_HOST=rosgrid_redis
REDIS_PORT=6379
REDIS_PASSWORD=cambiar_en_entorno_local

# --- Criptografía y Seguridad (Generar con: openssl rand -base64 32) ---
ROSGRID_MASTER_VAULT_KEY=reemplazar_con_32_bytes_base64_para_aes_256_gcm
ROSGRID_JWT_SECRET_KEY=reemplazar_con_secreto_criptografico_jwt
ROSGRID_CSRF_HMAC_SECRET=reemplazar_con_secreto_criptografico_csrf

# --- Parámetros Operativos MikroTik ---
ROSGRID_MIKROTIK_TIMEOUT_SECONDS=10
ROSGRID_SAFEMODE_ROLLBACK_SECONDS=60
ROSGRID_BACKUP_RETENTION_DAYS=30

# --- MCP (Model Context Protocol) ---
ROSGRID_MCP_ENABLED=false
ROSGRID_MCP_RATE_LIMIT_PER_MIN=30

# --- Configuración de Orígenes Cruzados (CORS) y Despliegue Separado ---
ROSGRID_CORS_ORIGINS=*
ROSGRID_CROSS_ORIGIN_COOKIES=false
VITE_API_BASE_URL=http://localhost:8080

# --- Cadenas de Conexión Directa (Opcional para DB/Redis Externos o Managed Cloud) ---
# ROSGRID_DATABASE_URL=postgresql+asyncpg://rosgrid_user:cambiar_en_entorno_local@rosgrid_db:5432/rosgrid
# ROSGRID_SYNC_DATABASE_URL=postgresql://rosgrid_user:cambiar_en_entorno_local@rosgrid_db:5432/rosgrid
# ROSGRID_REDIS_URL=redis://:cambiar_en_entorno_local@rosgrid_redis:6379/0

# --- Parámetros de Contenedores y Sistema ---
TZDATA=America/Caracas
restart=unless-stopped
