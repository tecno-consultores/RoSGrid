module.exports = {
  ci: {
    collect: {
      // Apunta al contenedor Nginx donde se sirve la UI compilada
      url: ['http://ui-prod:80/'],
      numberOfRuns: 3,
    },
    assert: {
      assertions: {
        // Exige rendimiento nivel corporativo (90+)
        'categories:performance': ['error', { minScore: 0.9 }],
        'categories:accessibility': ['error', { minScore: 0.95 }],
        'categories:best-practices': ['error', { minScore: 0.9 }],
        'categories:seo': ['error', { minScore: 0.9 }],
      },
    },
    upload: {
      target: 'filesystem',
      outputDir: './lhci-reports',
    },
  },
};
